[Unit]
Description=Proxmox event bus daemon
Documentation=https://github.com/Hostzero-GmbH/proxmox-eventbus
After=network-online.target pve-cluster.service
Wants=pve-cluster.service
PartOf=pve-cluster.service

[Service]
Type=notify
NotifyAccess=main
User=proxmox-eventbus
Group=www-data
ExecStart=/usr/bin/proxmox-eventbus --config /etc/proxmox-eventbus/config.yaml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# CAP_DAC_READ_SEARCH lets the daemon read root-only files (PVE writes
# /run/qemu-server/<vmid>.pid mode 0600 root:root). With it we can do an
# active kill(pid,0) liveness probe against the QEMU PID instead of trusting
# file existence alone. Read-only: still can't write/connect to root-owned
# files, so QMP sockets (mode 0750) remain out of reach.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

# /proc is needed read-only so the migrate-target argv read works.
# pmxcfs (/etc/pve) is read-only for us; we only write logs to journald.
ReadOnlyPaths=/etc/pve /var/log/pve /proc

[Install]
WantedBy=multi-user.target
